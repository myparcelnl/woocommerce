{
  "name": "@myparcel-woocommerce/monorepo",
  "version": "6.12.0",
  "private": true,
  "homepage": "https://github.com/myparcelnl/woocommerce#readme",
  "bugs": {
    "url": "https://github.com/myparcelnl/woocommerce/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/myparcelnl/woocommerce"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyse": "pnpm docker composer analyse",
    "analyse:generate": "pnpm docker composer analyse:generate",
    "analyze": "pnpm docker composer analyze",
    "analyze:generate": "pnpm docker composer analyze:generate",
    "build": "pnpm build:js",
    "build:dev": "pnpm build:js:dev",
    "build:js": "nx run-many --output-style=stream --target=build",
    "build:js:dev": "nx run-many --output-style=stream --target=build:dev",
    "build:js:dev:backend": "pnpm build:js:dev --projects='*/backend-*'",
    "build:js:dev:blocks": "pnpm build:js:dev --projects='*/block-*'",
    "build:js:dev:frontend": "pnpm build:js:dev --projects='*/frontend-*'",
    "build:js:test": "nx run-many --output-style=stream --target=build:test",
    "build:test": "pnpm build:js:test",
    "clean": "nx run-many --output-style=stream --parallel=99 --target=clean",
    "docker": "docker compose run --rm -it php",
    "docker:build": "docker build -t myparcelnl/woocommerce .",
    "docker:run": "docker run -it --rm -v $(pwd):/app myparcelnl/woocommerce",
    "lint": "prettier --write '**/*.{md,json,yml,css,scss}'",
    "prepare": "is-ci || husky install",
    "test": "nx run-many --output-style=stream --target=test",
    "test:coverage": "nx run-many --output-style=stream --target=test:coverage",
    "test:run": "nx run-many --output-style=stream --target=test:run",
    "translations:import": "pnpm pdk-builder translations",
    "update-wc-types": "bash private/updateTypes.sh",
    "watch": "pnpm build:js:dev --parallel=99 -- --watch",
    "watch:backend": "pnpm build:js:dev:backend --parallel=99 -- --watch",
    "watch:blocks": "pnpm build:js:dev:blocks --parallel=99 -- --watch",
    "watch:frontend": "pnpm build:js:dev:frontend --parallel=99 -- --watch",
    "watch:test": "pnpm build:js:test --parallel=99 -- --watch"
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix",
    "*.{md,json,yml,css,scss}": "prettier --write",
    "package.json": "pnpm dlx sort-package-json"
  },
  "prettier": "@myparcel-dev/prettier-config",
  "devDependencies": {
    "@myparcel-dev/eslint-config-esnext": "^1.4.0",
    "@myparcel-dev/eslint-config-import": "^1.3.0",
    "@myparcel-dev/eslint-config-node": "^1.4.0",
    "@myparcel-dev/eslint-config-prettier": "^1.4.0",
    "@myparcel-dev/eslint-config-prettier-typescript": "^1.4.0",
    "@myparcel-dev/eslint-config-prettier-typescript-vue": "^1.4.0",
    "@myparcel-dev/pdk-app-builder": "^4.1.4",
    "@myparcel-dev/prettier-config": "^2.0.1",
    "@myparcel-dev/semantic-release-config": "^7.0.0",
    "@myparcel-dev/semantic-release-wordpress-readme-generator": "^1.3.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@types/wordpress__block-editor": "*",
    "@types/wordpress__blocks": "*",
    "@types/wordpress__data": "*",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/tsconfig": "^0.9.1",
    "@wordpress/data": "wp-6.0",
    "array.prototype.flatmap": "^1.3.1",
    "eslint": "^8.34.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-sort-exports": "^0.9.0",
    "husky": "^9.0.0",
    "is-ci": "^4.1.0",
    "lint-staged": "^15.0.0",
    "nx": "^23.2.1",
    "prettier": "^2.8.4",
    "react": "*",
    "react-dom": "*",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.6.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.6",
      "onFail": "download"
    }
  }
}
